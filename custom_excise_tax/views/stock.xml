<odoo>

    <record model="ir.ui.view" id="view_stock_picking_form_custom">
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_picking_move_tree']" position="before">
                <field name="excise_register_id" invisible="1"/>
                <button type="object"
                        name="action_view_excise_register"
                        class="oe_stat_button"
                        icon="fa-file-o"
                        string="Excise Register"
                        attrs="{'invisible': [('excise_register_count', '=', 0)]}">
                        <field name="excise_register_count" widget="statinfo" string="Excise Register"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="view_location_form_custom" model="ir.ui.view">
        <field name="name">stock.location.form.custom</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='replenish_location']" position="after">
                <field name="is_excise_depot"/>
                <field name="bonded_warehouse_number" attrs="{'invisible': [('is_excise_depot', '=', False)]}"/>
            </xpath>
        </field>
    </record>

    <record id="stock_quant_search_view_inherit" model="ir.ui.view">
        <field name="name">stock.quant.search.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.quant_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='transit_loc']" position="after">
                <filter string="Excise depots" name="expise_depot_loc" domain="[('location_id.is_excise_depot','=', True)]"/>
            </xpath>
        </field>
     </record>

     <record id="stock_quant_tree_view_inherit" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_editable"></field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='reserved_quantity']" position="after">
                <field name="product_volume" sum="Volume (L)"/>
                <field name="product_alcohol_volume"/>
                <field name="product_alcohol_100_volume" sum="Alcohol Vol. (real)"/>
            </xpath>
        </field>
    </record>
</odoo>