<odoo>
  <data>
    <template id="report_purchaseorder_document" inherit_id="purchase.report_purchaseorder_document">
         <xpath expr="//div[@id='total']" position="before">
            <t t-set="purchase_order" t-value="o"/>
            <div class="row justify-content-end">
               <div class="col-4">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td>Total emptygoods excl.</td>
                            <td class="text-end"><span t-esc="purchase_order.amount_emptygoods_price_total" t-options='{"widget": "monetary", "display_currency": purchase_order.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Empty goods (+)</td>
                            <td class="text-end"><span t-esc="purchase_order.amount_emptygoods_plus" t-options='{"widget": "monetary", "display_currency": purchase_order.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Empty goods (-)</td>
                            <td class="text-end"><span t-esc="purchase_order.amount_emptygoods_min" t-options='{"widget": "monetary", "display_currency": purchase_order.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Total empty goods</td>
                            <td class="text-end"><span t-esc="purchase_order.amount_emptygoods_total" t-options='{"widget": "monetary", "display_currency": purchase_order.currency_id}'/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>
  </data>
</odoo>