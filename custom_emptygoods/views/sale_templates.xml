<odoo>
  <data>
    <template id="custom_sale_order_portal_content" inherit_id="sale.sale_order_portal_content">
        <xpath expr="//div[@id='total']" position="before">
            <div class="row">
                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                    <table class="table table-sm">
                        <tr>
                            <td>Total emptygoods excl.</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_price_total" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Empty goods (+)</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_plus" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Empty goods (-)</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_min" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Total empty goods</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_total" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>

    <template id="report_saleorder_document" inherit_id="sale.report_saleorder_document">
         <xpath expr="//div[@id='total']" position="before">
            <t t-set="sale_order" t-value="doc"/>
            <div class="row">
                <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                    <table class="table table-sm table-borderless">
                        <tr>
                            <td>Total emptygoods excl.</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_price_total" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Empty goods (+)</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_plus" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Empty goods (-)</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_min" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                        <tr>
                            <td>Total empty goods</td>
                            <td class="text-end"><span t-esc="sale_order.amount_emptygoods_total" t-options='{"widget": "monetary", "display_currency": sale_order.pricelist_id.currency_id}'/></td>
                        </tr>
                    </table>
                </div>
            </div>
        </xpath>
    </template>
  </data>
</odoo>