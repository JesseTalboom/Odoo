<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

     <template id="external_layout_standard_profitdrinks" inherit_id="web.external_layout_standard">
        <xpath expr="//ul[@class='list-inline mb4']" position="replace">
            <ul class="list-inline mb0">
                    <div t-field="company.report_footer"/>
                    <p>Powered by
                            <a target="_blank" href="http://www.profitdrinks.be" title="Profitdrinks">
                                <img src="/custom_odoo_debranding/static/src/img/logo.png" alt="Profitdrinks Logo" height="50"/>
                            </a>
                            software
                    </p>
            </ul>
        </xpath>
    </template>

